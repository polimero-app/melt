{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melt",
  "version": "0.1.0",
  "identifier": "app.polimero.melt",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "title": "m e l t",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../../LICENSE"],
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
